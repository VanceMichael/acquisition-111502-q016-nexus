#NEXUS
BEGIN TAXA; DIMENSIONS NTAX=3; TAXLABELS 'tax a' B C; END;
BEGIN CHARACTERS; DIMENSIONS NCHAR=6; FORMAT DATATYPE=DNA GAP=- MISSING=? MATCHCHAR=. INTERLEAVE; MATRIX
 'tax a' AC
 B .?
 C AG

 'tax a' GT
 B T-
 C (AG)T

 'tax a' AC
 B AC
 C AC
; END;
BEGIN SETS; CHARSET first=1-3; END;
BEGIN TREES; TRANSLATE 1 'tax a', 2 B, 3 C; TREE t1=[&R](1:0.1,(2:0.1,3:0.2):0.3); END;
